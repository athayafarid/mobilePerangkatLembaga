<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FE"
    android:padding="20dp"
    tools:context=".Home.pertemuan7.DuaFragment">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TUGAS POKOK PERANGKAT DESA"
                android:textColor="#6A5ACD"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Melaksanakan kegiatan pelayanan administratif, pengelolaan keuangan desa, pembinaan kemasyarakatan, serta mengawal seluruh program pembangunan desa agar berjalan lancar dan transparan."
                android:textColor="@color/black"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#EEEEEE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FUNGSI UTAMA"
                android:textColor="#6A5ACD"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="1. Pelayanan Publik: Melayani pengurusan surat menyurat, KTP/KK, dan surat keterangan lainnya.&#10;&#10;2. Pembangunan: Mengelola perencanaan pembangunan infrastruktur desa.&#10;&#10;3. Pengawasan: Menjaga akuntabilitas penggunaan dana desa."
                android:textColor="#424242"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>